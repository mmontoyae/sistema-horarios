# Copiar este archivo como .env en la instancia y cambiar la contrasena.
# El archivo .env no se sube al repositorio.
#
#   cp .env.ejemplo .env
#
# SQL Server exige al menos 8 caracteres con mayusculas, minusculas,
# numeros y algun simbolo.

CLAVE_SA=CambiaEstaClave2026!

# Origenes permitidos para CORS. Con Nginx haciendo de intermediario
# el frontend y la API comparten dominio, asi que no suele hacer falta.
ORIGENES_PERMITIDOS=
